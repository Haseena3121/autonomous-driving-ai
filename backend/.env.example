# =====================================================================
# Environment variables for the ADAS backend
# Copy this file to .env for local development (never commit .env)
# On Render: set these in the dashboard Environment tab
# =====================================================================

# MongoDB Atlas connection string — REQUIRED for cloud deployment
ADAS_MONGO_URI=mongodb+srv://adas_user:<db_password>@cluster0.5dbfmfu.mongodb.net/adas_database?retryWrites=true&w=majority

# MongoDB database name
ADAS_MONGO_DB=adas_database

# Server config (Render sets PORT automatically)
ADAS_HOST=0.0.0.0
ADAS_DEBUG=0

# CORS — set to your Render URL in production
ADAS_CORS_ORIGINS=*
